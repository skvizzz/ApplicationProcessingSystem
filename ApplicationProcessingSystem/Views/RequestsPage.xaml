<Page x:Class="ApplicationProcessingSystem.Views.RequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Все заявки"
      Background="#A4F5EB">

    <Page.Resources>

        <!-- Кнопка возврата к созданию заявки -->
        <Style x:Key="CreateRequestButtonStyle"
               TargetType="Button">

            <Setter Property="Background" Value="#69F33F"/>
            <Setter Property="Foreground" Value="#173322"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="28,13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#56DE30"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#45C923"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#255E38"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий вид текста в строках -->
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#303744"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Выделение и двойной щелчок по строке -->
        <Style x:Key="RequestItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>

            <EventSetter Event="MouseDoubleClick"
                         Handler="RequestItem_MouseDoubleClick"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#F0F6FF"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="BorderBrush"
                                        Value="#4E70FF"/>
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#EDF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Все заявки"
                   FontSize="27"
                   FontWeight="SemiBold"
                   Foreground="#263847"
                   Margin="0,0,0,18"/>

        <!-- Поиск -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="18,12"
                Margin="0,0,0,14">

            <Grid>
                <TextBox x:Name="SearchTextBox"
                         FontSize="18"
                         Foreground="#303744"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"
                         AutomationProperties.Name="Поиск заявок"/>

                <!-- Подсказка (Placeholder) -->
                <TextBlock Text="Поиск по коду, датам, госномеру или статусу..."
                           FontSize="18"
                           Foreground="#9097A2"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <!-- Показываем, если текст пустой -->
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Контейнер заявок -->
        <Border Grid.Row="2"
                Background="#9EC5FA"
                BorderBrush="#879FFC"
                BorderThickness="2"
                CornerRadius="18"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовки колонок -->
                <Grid Grid.Row="0" Margin="2,4,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Код заявки"
                               Style="{StaticResource RowTextStyle}"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="1"
                               Text="Дата начала"
                               Style="{StaticResource RowTextStyle}"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="2"
                               Text="Дата окончания"
                               Style="{StaticResource RowTextStyle}"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="3"
                               Text="Госномер"
                               Style="{StaticResource RowTextStyle}"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="4"
                               Text="Статус"
                               Style="{StaticResource RowTextStyle}"
                               FontWeight="SemiBold"/>
                </Grid>

                <ListBox x:Name="RequestsListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         SelectionMode="Single"
                         ItemContainerStyle="{StaticResource RequestItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding CodeZayavki, StringFormat='№ {0:D6}'}"
                                           Style="{StaticResource RowTextStyle}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DataNachala, StringFormat='{}{0:dd.MM.yyyy}'}"
                                           Style="{StaticResource RowTextStyle}"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DataOkonchaniya, StringFormat='{}{0:dd.MM.yyyy}'}"
                                           Style="{StaticResource RowTextStyle}"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding GosNomer}"
                                           Style="{StaticResource RowTextStyle}"/>

                                <!-- Цвет статуса зависит от его значения -->
                                <Border Grid.Column="4"
                                        Margin="4,8,8,8"
                                        CornerRadius="13"
                                        Padding="6">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#E0E5EB"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Проверка">
                                                    <Setter Property="Background" Value="#4E70FF"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Отклонена">
                                                    <Setter Property="Background" Value="#FF7787"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Принята">
                                                    <Setter Property="Background" Value="#89F86B"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Уточнение">
                                                    <Setter Property="Background" Value="#FFD477"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Status}"
                                               FontSize="16"
                                               Foreground="#17212F"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Сообщение при отсутствии результатов -->
                <TextBlock x:Name="EmptyTextBlock"
                           Grid.Row="1"
                           Text="Заявки не найдены"
                           FontSize="20"
                           Foreground="#344A68"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                <!-- Текст с количеством найденных результатов -->
                <TextBlock x:Name="ResultsTextBlock"
                           Grid.Row="2"
                           Margin="10,8,0,0"
                           Foreground="#344A68"
                           FontSize="13"/>
            </Grid>
        </Border>

        <!-- Кнопка возврата -->
        <Button Grid.Row="3"
                Content="Вернуться к созданию заявки"
                Style="{StaticResource CreateRequestButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Click="CreateRequestButton_Click"/>
    </Grid>
</Page>
