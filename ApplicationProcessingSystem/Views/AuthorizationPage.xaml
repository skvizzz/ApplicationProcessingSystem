<Page x:Class="ApplicationProcessingSystem.Views.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationProcessingSystem.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">


    <Grid Margin="40">
        <StackPanel Width="260"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,45">

            <!-- Место для логотипа -->
            <Border Width="124"
                    Height="54"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">

                <Image Source="/Signs/Logo.png" Margin="-16,-9,-16,-9"/>

            </Border>

            <!-- Поле логина -->
            <Border Height="41"
                    Background="#FAFAFA"
                    CornerRadius="14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка логина -->
                    <Border Grid.Column="0"
                            Background="#FF4562"
                            CornerRadius="14">

                        <Image Source="/Signs/LoginSign.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="LoginTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,0,10,0"
                                 FontSize="18"
                                 Foreground="#333333"
                                 VerticalContentAlignment="Center"
                                 MaxLength="100"
                                 TabIndex="0"
                                 AutomationProperties.Name="Логин"/>

                        <TextBlock Text="Введите логин">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource PlaceholderStyle}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Text.Length, ElementName=LoginTextBox}"
                                            Value="0">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Поле пароля -->
            <Border Height="41"
                    Background="#FAFAFA"
                    CornerRadius="14"
                    Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка пароля -->
                    <Border Grid.Column="0"
                            Background="#FF4562"
                            CornerRadius="14">

                        <Image Source="/Signs/PasswordSing.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="PasswordInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10,0,10,0"
                                     FontSize="18"
                                     Foreground="#333333"
                                     VerticalContentAlignment="Center"
                                     TabIndex="1"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     AutomationProperties.Name="Пароль"/>

                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text="Введите пароль"
                                   Style="{StaticResource PlaceholderStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Кнопка входа -->
            <Button Content="Войти"
                    Height="41"
                    Margin="0,28,0,0"
                    Style="{StaticResource ButtonStyle}"
                    IsDefault="True"
                    TabIndex="2"
                    Click="LoginButton_Click"/>

            <!-- Сообщения о заполнении полей -->
            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,0"
                       FontSize="13"
                       Foreground="#8B2335"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

        </StackPanel>
    </Grid>
</Page>
