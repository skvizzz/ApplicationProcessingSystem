<Page x:Class="ApplicationProcessingSystem.Views.ApplicationFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationProcessingSystem.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ApplicationFormPage">

    <Grid>
        <Button Content="Заявки"
            Height="41"
            HorizontalAlignment="Right"
            Style="{StaticResource ButtonStyle}"
            IsDefault="True"
            Width="80"
            Background="Red"
            Click="RequestsPageButton_Click" Margin="0,0,0,400"/>
        <StackPanel Width="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,45">

            <!-- Место для логотипа -->
            <Border Width="124"
                Height="54"
                HorizontalAlignment="Center"
                Margin="0,0,0,14">

                <Image Source="/Signs/Logo.png" Margin="-16,-9,-16,-9"/>

            </Border>

            <!-- Поле ввода ФИО клиента -->
            <Border Height="41"
                Background="#FAFAFA"
                CornerRadius="14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка клиента -->
                    <Border Grid.Column="0"
                        Background="#FF4562"
                        CornerRadius="14">

                        <Image Source="/Signs/LoginSign.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="ClientFIOTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,0"
                             FontSize="18"
                             Foreground="#333333"
                             VerticalContentAlignment="Center"
                             MaxLength="100"
                             TabIndex="0"
                             AutomationProperties.Name="ФИО клиента"/>

                        <TextBlock Text="ФИО клиента">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource PlaceholderStyle}">

                                    <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                        Binding="{Binding Text.Length, ElementName=ClientFIOTextBox}"
                                        Value="0">

                                            <Setter Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Поле телефона клиента -->
            <Border Height="41"
                Background="#FAFAFA"
                CornerRadius="14"
                Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка телефона -->
                    <Border Grid.Column="0"
                        Background="#FF4562"
                        CornerRadius="14">

                        <Image Source="/Signs/PhoneSign.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="PhoneInputTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,0,10,0"
                                 FontSize="18"
                                 Foreground="#333333"
                                 VerticalContentAlignment="Center"
                                 TabIndex="1"
                                 
                                 AutomationProperties.Name="Номер клиента"/>

                        <TextBlock Text="Номер клиента">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                    BasedOn="{StaticResource PlaceholderStyle}">

                                    <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                             Binding="{Binding Text.Length, ElementName=PhoneInputTextBox}" Value="0">

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Поле выбора машины -->
            <Border Height="41"
                Background="#FAFAFA"
                CornerRadius="14"
                Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка Машины -->
                    <Border Grid.Column="0"
                        Background="#FF4562"
                        CornerRadius="14">

                        <Image Source="/Signs/CarSign.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <ComboBox x:Name="CarInputComboBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,0"
                             FontSize="18"
                             Foreground="#333333"
                             VerticalContentAlignment="Center"
                             TabIndex="1"
                             DisplayMemberPath="DisplayText"
                             SelectedValuePath="КодАвтомобиля"
                             SelectedValue="{Binding SelectedCarId, Mode=TwoWay}"
                             AutomationProperties.Name="Автомобиль"/>

                        <TextBlock Text="Автомобиль">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                        BasedOn="{StaticResource PlaceholderStyle}">

                                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                 Binding="{Binding Text.Length, ElementName=CarInputComboBox}" Value="0">

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <!-- Поле ввода даты начала -->
            <Border Height="41"
                Background="#FAFAFA"
                CornerRadius="14"
                Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка даты-->
                    <Border Grid.Column="0"
                        Background="#FF4562"
                        CornerRadius="14">

                        <Image Source="/Signs/WatchSing.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <DatePicker x:Name="DateStartInput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,0,10,0"
                                 FontSize="18"
                                 Foreground="#333333"
                                 VerticalContentAlignment="Center"
                                 TabIndex="1"
                                 
                                 
                                 AutomationProperties.Name="Дата начала"/>

                    </Grid>
                </Grid>
            </Border>
            <!-- Поле ввода даты окончания -->
            <Border Height="41"
                Background="#FAFAFA"
                CornerRadius="14"
                Margin="0,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Место для значка телефона -->
                    <Border Grid.Column="0"
                        Background="#FF4562"
                        CornerRadius="14">

                        <Image Source="/Signs/WatchSing.png"></Image>

                    </Border>

                    <Grid Grid.Column="1">
                        <DatePicker x:Name="DateEndInput"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,0"
                             FontSize="18"
                             Foreground="#333333"
                             VerticalContentAlignment="Center"
                             TabIndex="1"
                             
                             AutomationProperties.Name="Дата окончания"/>
                    </Grid>
                </Grid>
            </Border>


            <!-- Кнопка создания заявки -->
            <Button Content="Сформировать заявку"
                Height="41"
                Margin="0,28,0,0"
                Style="{StaticResource ButtonStyle}"
                IsDefault="True"
                TabIndex="2"
                Click="AddApplicationButton_Click"/>

            <!-- Сообщения о заполнении полей -->
            <TextBlock x:Name="StatusText"
                   Margin="0,12,0,0"
                   FontSize="13"
                   Foreground="#8B2335"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        </StackPanel>
    </Grid>
</Page>
